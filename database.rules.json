{
  "rules": {
    "live": {
      ".read": true,
      ".indexOn": ["t"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['km', 'dir', 't']) && (!data.exists() || now - data.child('t').val() > 4000)",
        "km": { ".validate": "newData.isNumber() && newData.val() >= -0.5 && newData.val() <= 21" },
        "dir": { ".validate": "newData.val() === 'N' || newData.val() === 'S'" },
        "v": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 120" },
        "t": { ".validate": "newData.val() === now" },
        "$other": { ".validate": false }
      }
    },
    "alerts": {
      ".read": true,
      "$id": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['title', 'level', 'from', 't', 'by'])",
        "title": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 140" },
        "titleBn": { ".validate": "newData.isString() && newData.val().length <= 140" },
        "body": { ".validate": "newData.isString() && newData.val().length <= 600" },
        "bodyBn": { ".validate": "newData.isString() && newData.val().length <= 600" },
        "level": { ".validate": "newData.val() === 'info' || newData.val() === 'delay' || newData.val() === 'closed'" },
        "stations": { ".validate": "newData.isString() && newData.val().length <= 400" },
        "from": { ".validate": "newData.isNumber()" },
        "until": { ".validate": "newData.isNumber() && newData.val() > now" },
        "t": { ".validate": "newData.val() === now" },
        "by": { ".validate": "newData.val() === auth.uid" },
        "$other": { ".validate": false }
      }
    },
    "admins": {
      "$uid": { ".read": "auth != null && auth.uid === $uid" }
    }
  }
}
